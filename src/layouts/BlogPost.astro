---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Tag from '../components/Tag.astro';
import BaseHead from '../components/BaseHead.astro';
import NavBar from '../components/NavBar.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, tags } = Astro.props;
---

<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="bg-background min-h-screen">
    <header class="bg-navBg-light dark:bg-navBg-dark backdrop-blur">
      <NavBar />
    </header>

    <main class="max-w-sm pb-16 m-auto sm:max-w-xl md:max-w-2xl lg:max-w-4xl">
      <section class="pt-6 sticky top-0 z-10 bg-background">
        <h1
          class="text-2xl font-bold capitalize font-headline text-headline sm:text-3xl"
        >
          {title}
        </h1>

        <p class="mt-4 text-xs sm:text-sm text-paragraph">
          <FormattedDate date={pubDate} />
        </p>

        <div class="mt-4 flex items-center justify-start gap-2">
          {tags.map(tag => <Tag content={tag} />)}
        </div>

        <hr class="my-5 text-gray-200 dark:text-gray-700" />
      </section>

      <div class="grid grid-cols-[auto_1fr] gap-8 relative">
        <div>
          <article
            class="prose font-content text-paragraph prose-code:text-code prose-a:text-link prose-blockquote:text-paragraph prose-strong:text-paragraph prose-em:text-reddish prose-em:font-semibold prose-headings:text-paragraph prose-headings:scroll-mt-44 prose-img:rounded prose-figure:text-paragraph prose-figure:text-center prose-figcaption:text-paragraph prose-figcaption:text-center prose-kbd:text-code"
          >
            <slot name="content" />
          </article>

          {
            updatedDate ? (
              <div>
                <hr class="my-5 text-gray-200 dark:text-gray-700" />
                <p class="pb-2 mt-2 text-xs sm:text-sm text-paragraph">
                  <span class="text-code font-content">Last Updated: </span>
                  <FormattedDate date={updatedDate} />
                </p>
              </div>
            ) : null
          }
        </div>

        <aside>
          <slot name="toc" />
        </aside>
      </div>
    </main>
  </body>
</html>
