---
import FormattedDate from './FormattedDate.astro';
import PostTitleLink from './PostTitleLink.astro';
import Tag from './Tag.astro';

type Props = {
  date: Date;
  featuredRank: number;
  heroImage: string;
  link: string;
  tags: string[];
  title: string;
  containerClasses: string;
  imgContainerClasses: string;
};

const {
  date,
  link,
  tags,
  title,
  heroImage,
  featuredRank,
  containerClasses,
  imgContainerClasses,
} = Astro.props;
---

<div class={containerClasses}>
  <a href={link} class={imgContainerClasses}>
    <img
      src={heroImage}
      alt={title}
      class="absolute w-full h-full object-cover sm:relative transition duration-300 ease-in-out hover:scale-105 hover:grayscale-50"
    />
  </a>

  <div
    class="py-3 px-5 sm:w-60 md:w-full md:h-full shrink-0 md:shrink flex flex-col justify-between items-start"
  >
    <div>
      <PostTitleLink title={title} link={link} />
    </div>

    <div>
      <p class="mt-6 text-xs text-paragraph sm:text-sm">
        <FormattedDate date={date} />
      </p>

      <div class="mt-2 flex items-center justify-start gap-2 flex-wrap">
        {tags.map(tag => <Tag content={tag} />)}
      </div>
    </div>
  </div>
</div>
