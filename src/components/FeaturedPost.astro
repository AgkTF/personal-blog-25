---
import FormattedDate from './FormattedDate.astro';
import PostTitleLink from './PostTitleLink.astro';
import Tag from './Tag.astro';

type Props = {
  date: Date;
  featuredRank: number;
  heroImage: string;
  link: string;
  tags: string[];
  title: string;
};

const { date, link, tags, title, heroImage, featuredRank } = Astro.props;
---

<div
  class="bg-card-bg rounded-xl shadow-lg overflow-hidden flex flex-col sm:flex-row md:flex-col min-w-[280px] lg:w-96"
>
  <a
    href={link}
    class="relative overflow-hidden pb-[58.33%] sm:pb-0 sm:h-64 sm:w-full"
  >
    <img
      src={heroImage}
      alt={title}
      class="absolute w-full h-full object-cover sm:relative transition duration-300 ease-in-out hover:scale-105 hover:grayscale-50"
    />
  </a>

  <div class="py-3 px-5 flex flex-col justify-between items-start">
    <div>
      <PostTitleLink title={title} link={link} />
    </div>

    <div>
      <p class="mt-6 text-xs text-paragraph sm:text-sm">
        <FormattedDate date={date} />
      </p>

      <div class="mt-2 flex items-center justify-start gap-2 flex-wrap">
        {tags.map(tag => <Tag content={tag} />)}
      </div>
    </div>
  </div>
</div>
