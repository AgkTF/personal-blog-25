---
type Props = {
  content: string;
};

const { content } = Astro.props;
---

<div
  class="px-1 text-xs font-medium capitalize rounded sm:px-2 sm:py-1 sm:rounded-md bg-highlight/25 text-highlight font-content sm:text-sm whitespace-nowrap"
>
  <a href={`/tags/${content.trim().toLowerCase()}/`}>{content}</a>
</div>
