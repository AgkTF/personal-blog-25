---
import FormattedDate from './FormattedDate.astro';
import PostTitleLink from './PostTitleLink.astro';
import Tag from './Tag.astro';

type Props = {
  date: Date;
  excerpt: string;
  link: string;
  tags: string[];
  title: string;
};

const { date, excerpt, link, tags, title } = Astro.props;
---

<div class="flex flex-col">
  <div class="mt-2">
    <div class="flex justify-between items-center gap-5">
      <PostTitleLink title={title} link={link} />
      <p class="text-xs text-paragraph sm:text-sm">
        <FormattedDate date={date} />
      </p>
    </div>

    <p class="mt-2 font-rubik text-paragraph text-sm sm:text-base line-clamp-3">
      {excerpt}
    </p>
  </div>

  <div class="mt-4 flex justify-between items-center">
    <div class="flex items-center justify-start gap-2">
      {tags.map(t => <Tag content={t} />)}
    </div>

    <a
      href={link}
      class="flex items-center font-rubik text-tertiary hover:text-highlight self-end"
    >
      <span class="font-medium text-sm sm:text-base">Read more</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16 16"
        fill="currentColor"
        class="ml-1 size-4"
      >
        <path
          fill-rule="evenodd"
          d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
          clip-rule="evenodd"></path>
      </svg>
    </a>
  </div>

  <!-- TODO: Should be hidden on the last post. -->
  <hr class="mt-4 opacity-10 text-paragraph" />
</div>
