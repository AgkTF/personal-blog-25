---
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../../components/PostPreview.astro';
import FeaturedPost from '../../components/FeaturedPost.astro';

const postsCollection = await getCollection('blog');

const featuredPosts = postsCollection
  .filter(p => p.data.featuredRank)
  .sort((a, b) => Number(a.data.featuredRank) - Number(b.data.featuredRank));

const latestPosts = postsCollection
  .filter(p => !p.data.featuredRank)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main
    class="max-w-sm sm:max-w-xl md:max-w-2xl lg:max-w-3xl flex flex-col justify-center mx-5 xs:mx-auto"
  >
    {
      featuredPosts.length > 0 ? (
        <section class="mt-6 sm:mt-10 w-full">
          <h1 class="font-bold font-sansita text-2xl sm:text-3xl text-headline">
            Featured
          </h1>

          <div class="mt-6 sm:mt-10 gap-6 lg:gap-8 grid grid-cols-1 md:grid-cols-2">
            <FeaturedPost
              date={featuredPosts[0].data.pubDate}
              featuredRank={featuredPosts[0].data.featuredRank!}
              heroImage={featuredPosts[0].data.heroImage!}
              link={`/blog/${featuredPosts[0].id}/`}
              tags={featuredPosts[0].data.tags}
              title={featuredPosts[0].data.title}
              containerClasses="bg-card-bg rounded-xl shadow-lg overflow-hidden flex flex-col sm:flex-row min-w-2xs md:col-span-2"
              imgContainerClasses="relative overflow-hidden min-h-64 lg:min-h-80 w-full md:w-2/3 md:shrink-0"
            />

            {featuredPosts.slice(1).map(post => (
              <FeaturedPost
                date={post.data.pubDate}
                featuredRank={post.data.featuredRank!}
                heroImage={post.data.heroImage!}
                link={`/blog/${post.id}/`}
                tags={post.data.tags}
                title={post.data.title}
                containerClasses="bg-card-bg rounded-xl shadow-lg overflow-hidden flex flex-col sm:flex-row md:flex-col min-w-2xs"
                imgContainerClasses="relative overflow-hidden min-h-64 w-full"
              />
            ))}
          </div>
        </section>
      ) : null
    }

    <section class="mt-8 sm:mt-12 w-full">
      <h1 class="font-bold font-sansita text-headline text-2xl sm:text-3xl">
        Latest
      </h1>

      <div class="mt-6 space-y-4">
        {
          latestPosts.map(post => (
            <PostPreview
              date={post.data.pubDate}
              excerpt={post.data.description}
              link={`/blog/${post.id}/`}
              tags={post.data.tags}
              title={post.data.title}
            />
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
