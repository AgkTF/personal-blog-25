---
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../../components/PostPreview.astro';
import Tag from '../../components/Tag.astro';

const postsCollection = await getCollection('blog');

const tags = new Set(postsCollection.flatMap(post => post.data.tags || []));

const latestPosts = postsCollection
  .filter(p => !p.data.featuredRank)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main
    class="grid md:grid-cols-[2fr_1fr] gap-20 max-w-sm mx-5 sm:max-w-xl md:max-w-2xl lg:max-w-4xl xs:mx-auto"
  >
    <section class="w-full mt-8 sm:mt-12">
      <h1 class="text-2xl font-bold font-sansita text-headline sm:text-3xl">
        Latest
      </h1>

      <div class="mt-6 space-y-4">
        {
          latestPosts.map(post => (
            <PostPreview
              date={post.data.pubDate}
              excerpt={post.data.description}
              link={`/blog/${post.id}/`}
              tags={post.data.tags}
              title={post.data.title}
            />
          ))
        }
      </div>
    </section>

    <section class="w-full md:mt-12">
      <h1 class="text-2xl font-bold font-sansita text-headline sm:text-3xl">
        Tags
      </h1>

      <div class="flex flex-wrap gap-2 mt-6 sm:gap-3">
        {
          Array.from(tags)
            .sort()
            .map(tag => <Tag content={tag} />)
        }
      </div>
    </section>
  </main>
</BaseLayout>
