---
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../../components/PostPreview.astro';
import Tag from '../../components/Tag.astro';

const postsCollection = await getCollection('blog');

const tags = new Set(postsCollection.flatMap(post => post.data.tags || []));

const latestPosts = postsCollection
  .filter(p => !p.data.featuredRank)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = postsCollection
  .filter(p => p.data.featuredRank)
  .sort((a, b) => Number(a.data.featuredRank) - Number(b.data.featuredRank));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main
    class="pb-8 grid md:grid-cols-[2fr_1fr] gap-20 max-w-sm mx-5 sm:max-w-xl md:max-w-2xl lg:max-w-4xl xs:mx-auto"
  >
    <section class="mt-8 sm:mt-12">
      <h1 class="text-2xl font-bold font-sansita text-headline sm:text-3xl">
        Latest
      </h1>

      <div class="mt-6 space-y-4">
        {
          latestPosts.map(post => (
            <PostPreview
              date={post.data.pubDate}
              excerpt={post.data.description}
              link={`/blog/${post.id}/`}
              tags={post.data.tags}
              title={post.data.title}
            />
          ))
        }
      </div>
    </section>

    <aside class="md:mt-12">
      <section>
        <h1 class="text-2xl font-bold font-sansita text-headline sm:text-3xl">
          Tags
        </h1>

        <div class="flex flex-wrap gap-2 mt-6 sm:gap-3">
          {
            Array.from(tags)
              .sort()
              .map(tag => <Tag content={tag} />)
          }
        </div>
      </section>

      {
        featuredPosts.length > 0 ? (
          <section class="mt-12">
            <h1 class="text-2xl font-bold font-sansita text-headline sm:text-3xl">
              Featured
            </h1>

            <div class="mt-6 space-y-3">
              {featuredPosts.map(post => (
                <div class="flex gap-2 text-headline hover:text-link">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    class="size-4 shrink-0 mt-2"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z"
                      clip-rule="evenodd"
                    />
                  </svg>

                  <h2 class="font-bold font-sansita text-lg">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                </div>
              ))}
            </div>
          </section>
        ) : null
      }
    </aside>
  </main>
</BaseLayout>
