---
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostPreview from '../../components/PostPreview.astro';
import Tag from '../../components/Tag.astro';
import SectionTitle from '../../components/SectionTitle.astro';

const postsCollection = await getCollection('blog');

const tags = new Set(postsCollection.flatMap(post => post.data.tags || []));

const latestPosts = postsCollection
  .filter(p => !p.data.featuredRank)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPosts = postsCollection
  .filter(p => p.data.featuredRank)
  .sort((a, b) => Number(a.data.featuredRank) - Number(b.data.featuredRank));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <main
    class="pb-8 grid md:grid-cols-[2fr_1fr] gap-20 max-w-sm mx-5 sm:max-w-xl md:max-w-2xl lg:max-w-4xl xs:mx-auto"
  >
    <section class="mt-8 sm:mt-12">
      <SectionTitle title="Latest">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M9 4.5a.75.75 0 0 1 .721.544l.813 2.846a3.75 3.75 0 0 0 2.576 2.576l2.846.813a.75.75 0 0 1 0 1.442l-2.846.813a3.75 3.75 0 0 0-2.576 2.576l-.813 2.846a.75.75 0 0 1-1.442 0l-.813-2.846a3.75 3.75 0 0 0-2.576-2.576l-2.846-.813a.75.75 0 0 1 0-1.442l2.846-.813A3.75 3.75 0 0 0 7.466 7.89l.813-2.846A.75.75 0 0 1 9 4.5ZM18 1.5a.75.75 0 0 1 .728.568l.258 1.036c.236.94.97 1.674 1.91 1.91l1.036.258a.75.75 0 0 1 0 1.456l-1.036.258c-.94.236-1.674.97-1.91 1.91l-.258 1.036a.75.75 0 0 1-1.456 0l-.258-1.036a2.625 2.625 0 0 0-1.91-1.91l-1.036-.258a.75.75 0 0 1 0-1.456l1.036-.258a2.625 2.625 0 0 0 1.91-1.91l.258-1.036A.75.75 0 0 1 18 1.5ZM16.5 15a.75.75 0 0 1 .712.513l.394 1.183c.15.447.5.799.948.948l1.183.395a.75.75 0 0 1 0 1.422l-1.183.395c-.447.15-.799.5-.948.948l-.395 1.183a.75.75 0 0 1-1.422 0l-.395-1.183a1.5 1.5 0 0 0-.948-.948l-1.183-.395a.75.75 0 0 1 0-1.422l1.183-.395c.447-.15.799-.5.948-.948l.395-1.183A.75.75 0 0 1 16.5 15Z"
            clip-rule="evenodd"></path>
        </svg>
      </SectionTitle>

      <div class="mt-6 space-y-4">
        {
          latestPosts.map(post => (
            <PostPreview
              date={post.data.pubDate}
              excerpt={post.data.description}
              link={`/blog/${post.id}/`}
              tags={post.data.tags}
              title={post.data.title}
            />
          ))
        }
      </div>
    </section>

    <aside class="md:mt-12">
      <section>
        <SectionTitle title="Tags">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M5.25 2.25a3 3 0 0 0-3 3v4.318a3 3 0 0 0 .879 2.121l9.58 9.581c.92.92 2.39 1.186 3.548.428a18.849 18.849 0 0 0 5.441-5.44c.758-1.16.492-2.629-.428-3.548l-9.58-9.581a3 3 0 0 0-2.122-.879H5.25ZM6.375 7.5a1.125 1.125 0 1 0 0-2.25 1.125 1.125 0 0 0 0 2.25Z"
              clip-rule="evenodd"></path>
          </svg>
        </SectionTitle>

        <div class="flex flex-wrap gap-2 mt-6 sm:gap-3">
          {
            Array.from(tags)
              .sort()
              .map(tag => <Tag content={tag} />)
          }
        </div>
      </section>

      {
        featuredPosts.length > 0 ? (
          <section class="mt-12">
            <SectionTitle title="Featured">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.006 5.404.434c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.434 2.082-5.005Z"
                  clip-rule="evenodd"
                />
              </svg>
            </SectionTitle>

            <div class="mt-6 space-y-3">
              {featuredPosts.map(post => (
                <div class="flex gap-2 text-headline hover:text-link">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="size-5 shrink-0 mt-1.5"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z"
                      clip-rule="evenodd"
                    />
                  </svg>

                  <h2 class="font-bold font-headline text-lg">
                    <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                  </h2>
                </div>
              ))}
            </div>
          </section>
        ) : null
      }
    </aside>
  </main>
</BaseLayout>
